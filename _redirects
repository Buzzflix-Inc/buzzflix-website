# Squarespace served the homepage at /home as well as /.
/home    /  301
/home/   /  301

# The homepage source pages are not public pages; the switch script publishes them at /.
/home-current          /  301
/home-current.html     /  301
/home-applications     /  301
/home-applications.html  /  301

# Project files that live in the repository but aren't part of the website.
/APPLICATIONS.md        /  301
/APPS-SCRIPT-SETUP.md   /  301
/CLOUDFLARE-CUTOVER.md  /  301
/apps-script/*          /  301
/scripts/*              /  301
/.claude/*              /  301
